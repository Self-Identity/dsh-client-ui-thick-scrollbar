{
  "name": "dsh-client-ui-thick-scrollbar",
  "version": "1.0.0",
  "description": "Global scrollbar thickness tuner for the DeepSeek Harness client: widen every scrollbar and adjust the width from the plugin page. 全局加粗 DSH 客户端滚动条，可在插件页调节宽度。",
  "license": "MIT",
  "author": "Self-Identity",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Self-Identity/dsh-client-ui-thick-scrollbar.git"
  },
  "homepage": "https://github.com/Self-Identity/dsh-client-ui-thick-scrollbar#readme",
  "bugs": {
    "url": "https://github.com/Self-Identity/dsh-client-ui-thick-scrollbar/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "icon": "./icon.svg",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "scrollbar",
    "appearance",
    "ui"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json"
  },
  "files": [
    "lib",
    "locale",
    "tools",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tools/smoke.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
